{
  "name": "opencode-sesh",
  "version": "2.1.1",
  "description": "OpenCode session browser: search, preview, and resume every session across every project from the terminal or TUI.",
  "type": "module",
  "license": "MIT",
  "author": "Ozan Dogrultan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ozandogrultan/opencode-sesh.git"
  },
  "homepage": "https://github.com/ozandogrultan/opencode-sesh#readme",
  "bugs": {
    "url": "https://github.com/ozandogrultan/opencode-sesh/issues"
  },
  "keywords": [
    "opencode",
    "sessions",
    "session-browser",
    "fzf",
    "tui",
    "cli",
    "opencode-plugin",
    "opencode-tui"
  ],
  "exports": {
    ".": "./plugins/sesh-list.ts",
    "./tui": "./dist/tui.js",
    "./tool": "./plugins/sesh-list.ts"
  },
  "bin": {
    "sesh": "bin/sesh"
  },
  "files": [
    "bin/",
    "dist/",
    "contrib/",
    "plugins/",
    "themes/",
    "tui-plugins/",
    "install.sh",
    "AGENTS.md",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=20",
    "opencode": ">=2.0.0"
  },
  "scripts": {
    "prepare": "husky",
    "build": "node scripts/build-tui.mjs",
    "prepack": "node scripts/build-tui.mjs",
    "test": "bun run test:unit && bash tests/changelog.sh",
    "test:unit": "node scripts/build-tui.mjs && bash tests/sesh.sh && bash tests/install.sh",
    "test:changelog": "bash tests/changelog.sh",
    "test:picker": "python3 tests/picker.py",
    "typecheck": "tsc --noEmit",
    "lint:sh": "for script in bin/*.sh bin/sesh install.sh tests/*.sh scripts/*.sh; do bash -n \"$script\" || exit; done",
    "postinstall": "bash install.sh --sync-panel || printf '%s\\n' 'sesh postinstall: panel sync failed; run bash install.sh --sync-panel after resolving the error above.' >&2",
    "prepublishOnly": "bun run test && bun run typecheck"
  },
  "peerDependencies": {
    "@opencode/plugin": ">=2.0.0",
    "@opentui/core": ">=0.5.8",
    "@opentui/solid": ">=0.5.8",
    "solid-js": ">=1.9.0"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-typescript": "7.29.7",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@opencode/client": "2.1.2",
    "@opencode/plugin": "2.1.2",
    "@opencode/theme": "2.1.2",
    "@opentui/core": "^0.6.5",
    "@opentui/keymap": "^0.6.5",
    "@opentui/solid": "^0.6.5",
    "@types/node": "26.6.5",
    "babel-preset-solid": "1.9.16",
    "husky": "^9.1.7",
    "solid-js": "1.9.15",
    "typescript": "7.0.2"
  }
}
