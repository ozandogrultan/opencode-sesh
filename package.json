{
  "name": "opencode-sesh",
  "version": "0.9.1",
  "description": "Browse, search, preview and resume opencode sessions from the terminal and the TUI.",
  "type": "module",
  "license": "MIT",
  "author": "Ozan Dogrultan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ozandogrultan/opencode-sesh.git"
  },
  "homepage": "https://github.com/ozandogrultan/opencode-sesh#readme",
  "bugs": {
    "url": "https://github.com/ozandogrultan/opencode-sesh/issues"
  },
  "keywords": [
    "opencode",
    "sessions",
    "session-browser",
    "fzf",
    "tui",
    "cli"
  ],
  "bin": {
    "sesh": "bin/sesh"
  },
  "files": [
    "bin/",
    "contrib/",
    "opencode/",
    "themes/",
    "tui/",
    "install.sh",
    "AGENTS.md",
    "CHANGELOG.md",
    "ROADMAP.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prepare": "husky",
    "test": "bash tests/sesh.sh && bash tests/changelog.sh",
    "test:unit": "bash tests/sesh.sh",
    "test:changelog": "bash tests/changelog.sh",
    "test:picker": "python3 tests/picker.py",
    "typecheck": "tsc --noEmit",
    "lint:sh": "for script in bin/*.sh bin/sesh install.sh tests/*.sh scripts/*.sh; do bash -n \"$script\" || exit; done",
    "postinstall": "bash install.sh --sync-panel || true",
    "prepublishOnly": "bun run test && bun run typecheck"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@opencode-ai/plugin": "1.18.30",
    "@opencode-ai/sdk": "1.18.30",
    "@opentui/core": "^0.5.11",
    "@opentui/keymap": "^0.5.11",
    "@opentui/solid": "^0.5.11",
    "@types/node": "26.5.1",
    "husky": "^9.1.7",
    "solid-js": "1.9.12",
    "typescript": "7.0.2"
  }
}
