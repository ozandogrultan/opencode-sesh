{
  "name": "opencode-sesh",
  "version": "0.1.3",
  "type": "module",
  "description": "Browse, search, preview and resume opencode sessions from the terminal and the TUI.",
  "license": "MIT",
  "author": "Ozan Dogrultan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ozandogrultan/opencode-sesh.git"
  },
  "homepage": "https://github.com/ozandogrultan/opencode-sesh#readme",
  "bugs": {
    "url": "https://github.com/ozandogrultan/opencode-sesh/issues"
  },
  "keywords": [
    "opencode",
    "sessions",
    "session-browser",
    "fzf",
    "tui",
    "cli"
  ],
  "bin": {
    "sesh": "bin/sesh"
  },
  "files": [
    "bin/",
    "opencode/",
    "themes/",
    "tui/",
    "install.sh",
    "AGENTS.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "bash tests/sesh.sh",
    "typecheck": "tsc -p tsconfig.json",
    "lint:sh": "bash -n bin/*.sh bin/sesh install.sh tests/sesh.sh",
    "prepublishOnly": "npm test && npm run typecheck"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.18.30",
    "@opencode-ai/sdk": "1.18.30",
    "@opentui/core": "^0.5.11",
    "@opentui/keymap": "^0.5.11",
    "@opentui/solid": "^0.5.11",
    "@types/node": "26.5.1",
    "solid-js": "1.9.12",
    "typescript": "7.0.2"
  }
}
